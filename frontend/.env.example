# Base URL of the deployed backend. Leave empty for local dev (Vite proxies
# /api -> http://localhost:8000). In production set this at build time, e.g.:
# VITE_API_URL=https://flood-risk-api.onrender.com
VITE_API_URL=

# Google Maps Platform key for Reality 3D (Map Tiles API / Photorealistic 3D Tiles).
# Put the real key in .env.local, not here.
VITE_GOOGLE_MAPS_API_KEY=
